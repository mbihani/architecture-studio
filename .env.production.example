# Environment variables for the Architecture Studio Databricks App deployment.
# Set these via Databricks App env vars / secrets (or copy to server/.env for a
# local production-mode run) and fill in the real values.

# Port the Express server listens on. Set automatically by Databricks Apps;
# override only for local runs. The server defaults to 8080 when unset.
PORT=8080

# Lucid OAuth credentials (optional — the app runs in mock mode without them,
# so the UI is fully exercisable end-to-end with stub data).
# Create a Lucid developer app at https://developer.lucid.co/.
LUCID_CLIENT_ID=
LUCID_CLIENT_SECRET=

# OAuth callback URL — must be the deployed app URL + /api/auth/lucid/callback.
LUCID_REDIRECT_URI=https://<your-app-url>.databricks.app/api/auth/lucid/callback

# Frontend origin — the deployed app URL. Used for post-OAuth redirects back
# to the UI.
FRONTEND_URL=https://<your-app-url>.databricks.app
