# Lucid OAuth credentials. Copy this file to server/.env and fill in real
# values from your Lucid developer app (https://developer.lucid.co/).
# While these are absent, the backend returns mock responses so the app shell
# is fully exercisable end-to-end.

LUCID_CLIENT_ID=
LUCID_CLIENT_SECRET=
LUCID_REDIRECT_URI=http://localhost:3001/api/auth/lucid/callback

# Frontend origin — the OAuth callback redirects here after token exchange
# (the backend has no UI of its own). Defaults to the Vite dev server.
FRONTEND_URL=http://localhost:5173
